# Données du corpus (volumineuses, hors versionnement)
corpus/
derivatives/
lib/kumiko/

# Base de données
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/

# OS / éditeurs
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*                 # verrous temporaires Office (Excel/Word) — ex. docs/exemples/~$*.xlsx

# Logs (sorties uvicorn/serveur, non versionnées)
*.log

# Spike OCR — artefacts générés (le code du spike est versionné, pas ses sorties)
spike/samples/
spike/report.html
spike/report.csv

# Exports de démonstration (les OUTILS sont versionnés, pas leurs sorties régénérables)
docs/exemples/

# Déploiement — secrets et état runtime (la config template est versionnée)
deploy/.env
# Le fichier des comptes porte des HASHS de mots de passe, et ce dépôt est PUBLIC.
# Seul le gabarit `users_database.example.yml` est versionné ; on le copie sur la
# machine qui héberge, comme `.env.example` → `.env` juste au-dessus.
deploy/authelia/users_database.yml
deploy/authelia/db.sqlite3
deploy/authelia/notification.txt
deploy/authelia/*.log

# Outillage Node (journal de bord `pilote`) — manifeste et lock versionnés (cf. QA-1),
# pas l'arbre installé
node_modules/

# Réglages Claude Code propres à la machine (chemins de scratchpad par session).
# `.claude/settings.json` (réglages PARTAGÉS du dépôt) reste versionnable s'il apparaît.
.claude/settings.local.json
