# Secrets d'Authelia — COPIE ce fichier en `deploy/.env` puis remplis les 3 valeurs.
# (deploy/.env est ignoré par git ; ne le commite jamais.)
#
# Génère chaque secret avec une longue chaîne aléatoire, par exemple :
#   openssl rand -hex 32
# ou, sans openssl :
#   docker run --rm authelia/authelia:4.38 authelia crypto rand --length 64 --charset alphanumeric

AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=

# ─── Domaines de l'instance ────────────────────────────────────────────────────
# Trois valeurs, pas une racine : le jour d'un vrai domaine, rien n'oblige les deux
# sous-domaines à partager le même préfixe.
#
# COOKIE_DOMAINE est le PARENT COMMUN des deux autres, et c'est là qu'Authelia pose le
# cookie de session. Ne jamais y mettre un domaine plus haut : le cookie partirait à tout
# ce domaine. Avec sslip.io, `sslip.io` seul enverrait votre session à toutes les
# instances du service. `verifier_deploiement.py --config` refuse ce cas.
#
# `sslip.io` résout n'importe quel nom contenant une IP vers cette IP — de vrais
# sous-domaines sans en posséder aucun, le temps que le DNS définitif suive. Forme à
# tirets : bd.203-0-113-42.sslip.io
BD_DOMAINE=bd.203-0-113-42.sslip.io
AUTH_DOMAINE=auth.203-0-113-42.sslip.io
COOKIE_DOMAINE=203-0-113-42.sslip.io

# ─── Référent (AUTH-4) ─────────────────────────────────────────────────────────
# À qui écrire quand on est bloqué. C'est le SEUL destinataire qu'une portée VIDE puisse
# lire : la personne que le bandeau envoie « demander un accès » ne voit aucune collection,
# donc aucun nom en base. Sans lui, le bandeau dit qu'il faut demander sans dire à qui.
#
# Facultatif, et le laisser vide est le bon choix en mono-poste comme pour un unique
# administrateur — cela devient un cul-de-sac dès le deuxième compte.
#
# Déclaratif : l'app ne connaît que les groupes de la personne qui frappe, elle ne peut
# donc pas vérifier que ce nom appartient encore à l'équipe.
# CONTACT accepte un courriel ou l'URL d'une page d'instance.
BD_REFERENT_NOM=
BD_REFERENT_CONTACT=
