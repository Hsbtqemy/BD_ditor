# Efface les bacs à sable dont le moment est venu (COL-4). Posé par un timer ; à la main,
# l'outil se lance tel quel (cf. docs/exploitation.md § Les bacs à sable).
#
#   sudo cp deploy/systemd/bd-bacs-a-sable.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bd-bacs-a-sable.timer
#
# La DATE est en base (`projet.efface_le`, le lundi à 4 h, heure de Paris) : ce service
# n'est qu'un battement, et un battement manqué se rattrape au suivant.
[Unit]
Description=BeDediteur — efface les bacs a sable dont le moment est venu
Documentation=file:///home/ubuntu/BD_ditor/docs/exploitation.md
After=docker.service
Requires=docker.service

[Service]
# `oneshot` : systemd n'en lance jamais deux à la fois — et l'outil tient en plus son
# propre verrou à la racine des données.
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/BD_ditor
# L'application vit dans le conteneur `bd-app` : le script y lance l'outil, sur sa base.
ExecStart=/home/ubuntu/BD_ditor/deploy/effacer-bacs-a-sable.sh

# Une unité systemd démarre avec un environnement quasi vide : sans PATH, `docker` ne se
# trouve pas, et l'échec ressemble à une panne de l'application.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Soixante-quinze bacs à sable d'une dizaine d'albums : quelques minutes au plus. Le
# défaut de 90 s couperait un effacement au milieu, qu'un battement suivant finirait ;
# vingt minutes laissent le mener au bout.
TimeoutStartSec=1200

# Pas de redémarrage automatique : le battement suivant, dans l'heure, refait ce qui reste.
