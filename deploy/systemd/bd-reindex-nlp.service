# Rattrape chaque nuit les lemmes et les tokens que l'application, spaCy en veille, n'a pas
# calculés (NLP-4). Posé par un timer ; à la main, le script se lance tel quel (cf.
# docs/exploitation.md § spaCy en veille).
#
#   sudo cp deploy/systemd/bd-reindex-nlp.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bd-reindex-nlp.timer
#
# Un passage manqué n'est pas perdu : le suivant rattrape tout ce qui reste, la liste se
# lisant dans la base (`database.regions_a_rattraper`) et non dans une file.
[Unit]
Description=BeDediteur — rattrape la nuit les lemmes et la grammaire (spaCy en veille)
Documentation=file:///home/ubuntu/BD_ditor/docs/exploitation.md
After=docker.service
Requires=docker.service

[Service]
# `oneshot` : systemd n'en lance jamais deux à la fois.
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/BD_ditor
# L'application vit dans le conteneur `bd-app` : le script y lance l'outil, sur sa base,
# avec `BD_NLP=1` pour ce seul processus.
ExecStart=/home/ubuntu/BD_ditor/deploy/reindex-nlp.sh

# Une unité systemd démarre avec un environnement quasi vide : sans PATH, `docker` ne se
# trouve pas, et l'échec ressemble à une panne de l'application.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Le chargement de spaCy (10 à 20 s) puis une journée de régions : quelques minutes. Une
# heure laisse passer un premier rattrapage du corpus entier, celui du lendemain de la
# mise en veille sur une base où beaucoup a été écrit.
TimeoutStartSec=3600

# Pas de redémarrage automatique : la nuit suivante refait ce qui reste.
